; code-mirror.commands: bindings to the CodeMirror package this directory is named
; after, with that package's JavaScript bundle. See CONVENTIONS.md.

; @codemirror/commands' own JS bundle needs @codemirror/language's global
; (__CM__language) set at run time, for the indentation commands (see
; js/shims/codemirror-language.js and DESIGN.md's friction notes); depending
; on cm_language below makes dune link its bundle.js in too, even though no
; value in this library's .ml/.mli mentions a Cm_language type.

(library
 (name cm_commands)
 (public_name code-mirror.commands)
 (libraries brr cm_state cm_view cm_language)
 (js_of_ocaml
  (javascript_files bundle.js)))

; bundle.js is generated from js/entries/commands.js and committed, so users
; need no node. Regenerate with `dune build --profile=with-bundle`
; after `npm install`.

(rule
 (target bundle.js)
 (mode promote)
 (enabled_if
  (= %{profile} with-bundle))
 (deps
  %{project_root}/js/build.sh
  (source_tree %{project_root}/js)
  (source_tree %{project_root}/node_modules))
 (action
  (chdir
   %{project_root}
   (run sh js/build.sh js/entries/commands.js %{target}))))
