; code-mirror.theme-one-dark: bindings to the CodeMirror package this directory is named
; after, with that package's JavaScript bundle. See CONVENTIONS.md.

(library
 (name cm_theme_one_dark)
 (public_name code-mirror.theme-one-dark)
 (libraries brr cm_state cm_view cm_language)
 (js_of_ocaml
  (javascript_files bundle.js)))

; bundle.js is generated from js/entries/theme_one_dark.js and committed, so users
; need no node. Regenerate with `dune build --profile=with-bundle`
; after `npm install`.

(rule
 (target bundle.js)
 (mode promote)
 (enabled_if
  (= %{profile} with-bundle))
 (deps
  %{project_root}/js/build.sh
  (source_tree %{project_root}/js)
  (source_tree %{project_root}/node_modules))
 (action
  (chdir
   %{project_root}
   (run sh js/build.sh js/entries/theme_one_dark.js %{target}))))
